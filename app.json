{
    "name": "photobooth-website",
    "description": "Professional Photobooth Website dengan Midtrans Payment",
    "buildpacks": [
        {
            "url": "heroku/php"
        },
        {
            "url": "heroku/nodejs"
        }
    ],
    "env": {
        "APP_ENV": {
            "description": "Application environment",
            "value": "production"
        },
        "APP_DEBUG": {
            "description": "Enable/disable debug mode",
            "value": "false"
        },
        "LOG_CHANNEL": {
            "value": "stack"
        }
    },
    "addons": ["heroku-postgresql", "heroku-redis"],
    "scripts": {
        "postdeploy": "php artisan migrate --force && php artisan config:cache && php artisan route:cache && php artisan view:cache"
    },
    "stack": "heroku-22"
}
